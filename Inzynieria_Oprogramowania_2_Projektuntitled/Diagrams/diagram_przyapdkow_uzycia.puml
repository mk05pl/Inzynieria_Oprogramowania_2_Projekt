@startuml diagram_przypadkow_uzycia

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam actor {
  BorderColor #1F4E79
  BackgroundColor #DEEAF1
  FontColor #1F4E79
  FontStyle bold
}

skinparam usecase {
  BackgroundColor #DEEAF1
  BorderColor #2E75B6
  FontName Arial
  FontSize 12
}

skinparam ArrowColor #2E75B6
skinparam ArrowFontName Arial
skinparam ArrowFontSize 11

skinparam rectangleBorderColor #2E75B6
skinparam rectangleBackgroundColor #F5F9FF
skinparam rectangleFontStyle bold
skinparam rectangleFontSize 14

title Diagram przypadków użycia\nSystem Zarządzania Kinem

left to right direction

actor "Klient" as Klient
actor "Pracownik" as Pracownik
actor "Menedzer" as Menedzer

rectangle "System Zarządzania Kinem" {

  usecase "Zaloguj sie\ndo systemu" as UC_Login

  usecase "Przegladaj\ndostepne seanse" as UC_Przegladaj
  usecase "Kup bilet" as UC_KupBilet
  usecase "Zwroc bilet" as UC_ZwrocBilet

  usecase "Sprzedaj bilet\nw kasie" as UC_SprzedajBilet
  usecase "Sprawdz dostepnosc\nmiejsc" as UC_SprawdzDostepnosc

  usecase "Dodaj seans\ndo repertuaru" as UC_DodajSeans

  usecase "Wyszukaj seans" as UC_WyszukajSeans
  usecase "Sprawdz wolnosc\nsali (isHallAvailable)" as UC_SprawdzSale

}

' Wszyscy loguja sie przez ten sam UC
Klient    --> UC_Login
Pracownik --> UC_Login
Menedzer  --> UC_Login

' Klient
Klient --> UC_Przegladaj
Klient --> UC_KupBilet
Klient --> UC_ZwrocBilet

' Pracownik
Pracownik --> UC_SprzedajBilet
Pracownik --> UC_SprawdzDostepnosc

' Menedzer
Menedzer --> UC_DodajSeans

' include
UC_KupBilet      ..> UC_WyszukajSeans
UC_SprzedajBilet ..> UC_WyszukajSeans
UC_DodajSeans    ..> UC_SprawdzSale

@enduml
